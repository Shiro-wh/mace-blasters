{
  "model": {
    "type": "select",
    "property": "custom_model_data",
    "fallback": {
      "type": "model",
      "model": "item/honeycomb"
    },
    "cases": [
      {
        "when": "shirowh",
        "model": {
          "type": "model",
          "model": "item/shirowh"
        }
      },
      {
        "when": "vaynilo",
        "model": {
          "type": "model",
          "model": "item/vaynilo"
		}
      },
	  {
        "when": "vorticepen",
        "model": {
          "type": "model",
          "model": "item/vorticepen"
      }
      },
	  {
        "when": "portal",
        "model": {
          "type": "model",
          "model": "item/portal"
      }
      },
	  {
        "when": "portal2",
        "model": {
          "type": "model",
          "model": "item/portal2"
      }
      },	  
    {
        "when": "logro-catpu",
        "model": {
          "type": "model",
          "model": "item/mundo"
      }
      },
    {
        "when": "logro-catse",
        "model": {
          "type": "model",
          "model": "item/interrogacion"
      }
      }
    ]
  }
}